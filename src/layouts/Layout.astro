---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Benjamin Aamann — Portfolio",
  description =
    "Portfolio by Benjamin Aamann — Visual Design, Content Creation & Digital Marketing.",
} = Astro.props;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#0d0b0b" />

    <title>{title}</title>

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <!-- Giver os smooth side transitions -->
    <ClientRouter />
  </head>

  <body>
    <slot />
  </body>
</html>