  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);


    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;


    /* HERO */

    if (!reducedMotion) {

      const heroTimeline =
        gsap.timeline({
          defaults: {
            ease: "power3.out",
          },
        });


      heroTimeline.from(
        ".hero__image",
        {
          opacity: 0,
          scale: 1.025,
          duration: 1.4,
        }
      );


      heroTimeline.from(
        ".hero__top",
        {
          opacity: 0,
          y: -14,
          duration: 0.75,
        },
        "-=1"
      );


      heroTimeline.from(
        ".hero__disciplines span",
        {
          opacity: 0,
          x: -20,
          duration: 0.6,
          stagger: 0.07,
        },
        "-=0.55"
      );


      heroTimeline.from(
        ".hero h1",
        {
          opacity: 0,
          y: 85,
          duration: 1.05,
        },
        "-=0.45"
      );


      heroTimeline.from(
        ".hero__intro",
        {
          opacity: 0,
          y: 18,
          duration: 0.7,
        },
        "-=0.55"
      );


      heroTimeline.from(
        ".hero__link",
        {
          opacity: 0,
          y: 15,
          duration: 0.65,
        },
        "-=0.42"
      );


      heroTimeline.from(
        ".hero__quote",
        {
          opacity: 0,
          x: 20,
          rotate: -4,
          duration: 0.8,
        },
        "-=0.55"
      );


      heroTimeline.from(
        ".hero__footer",
        {
          opacity: 0,
          duration: 0.6,
        },
        "-=0.3"
      );

    }


    /* DESKTOP PROJECT SLIDER */

    const section =
      document.querySelector<HTMLElement>(
        ".project-scroll"
      );


    const sticky =
      document.querySelector<HTMLElement>(
        ".project-scroll__sticky"
      );


    const track =
      document.querySelector<HTMLElement>(
        ".project-track"
      );


    const slides =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          ".project-slide"
        )
      );


    const infoNumber =
      document.querySelector<HTMLElement>(
        ".project-info__number"
      );


    const infoType =
      document.querySelector<HTMLElement>(
        ".project-info__type"
      );


    const infoTitle =
      document.querySelector<HTMLElement>(
        ".project-info__title"
      );


    const infoDisciplines =
      document.querySelector<HTMLElement>(
        ".project-info__disciplines"
      );


    const infoAction =
      document.querySelector<HTMLElement>(
        ".project-info__action"
      );


    const headerNumber =
      document.querySelector<HTMLElement>(
        ".project-header__number"
      );


    const bottomCurrent =
      document.querySelector<HTMLElement>(
        ".project-bottom__current"
      );


    const progressFill =
      document.querySelector<HTMLElement>(
        ".project-progress__fill"
      );


    let activeIndex = -1;


    const updateProjectInfo =
      (index: number) => {

        const slide =
          slides[index];


        if (
          !slide ||
          index === activeIndex
        ) {
          return;
        }


        activeIndex =
          index;


        slides.forEach(
          (item, itemIndex) => {

            const active =
              itemIndex === index;


            item.classList.toggle(
              "is-active",
              active
            );


            item.style.pointerEvents =
              active
                ? "auto"
                : "none";

          }
        );


        const number =
          slide.dataset.number ?? "";


        const type =
          slide.dataset.type ?? "";


        const title =
          slide.dataset.title ?? "";


        const disciplines =
          slide.dataset.disciplines ?? "";


        const action =
          slide.dataset.action ?? "";


        if (infoNumber) {
          infoNumber.textContent =
            number;
        }


        if (infoType) {
          infoType.textContent =
            type;
        }


        if (infoDisciplines) {
          infoDisciplines.textContent =
            disciplines;
        }


        if (infoAction) {

          infoAction.textContent =
            action === "COMING SOON"
              ? "COMING SOON"
              : `${action.toUpperCase()} ↗`;

        }


        if (headerNumber) {
          headerNumber.textContent =
            `${number} / 05`;
        }


        if (bottomCurrent) {
          bottomCurrent.textContent =
            number;
        }


        if (infoTitle) {

          gsap.to(
            infoTitle,
            {

              opacity: 0,

              y: 5,

              duration: 0.12,

              onComplete: () => {

                infoTitle.textContent =
                  title;


                gsap.fromTo(
                  infoTitle,
                  {
                    opacity: 0,
                    y: 5,
                  },
                  {
                    opacity: 1,
                    y: 0,
                    duration: 0.25,
                    ease: "power2.out",
                  }
                );

              },

            }
          );

        }

      };


    const updateSlides =
      () => {

        const viewportCenter =
          window.innerWidth / 2;


        slides.forEach(
          (slide) => {

            const rect =
              slide.getBoundingClientRect();


            const center =
              rect.left +
              rect.width / 2;


            const distance =
              Math.abs(
                viewportCenter -
                center
              );


            const range =
              slide.offsetWidth *
              1.2;


            const focus =
              Math.max(
                0,
                Math.min(
                  1,
                  1 -
                  distance /
                  range
                )
              );


            slide.style.opacity =
              String(
                0.28 +
                focus *
                0.72
              );

          }
        );

      };


    if (
      section &&
      sticky &&
      track &&
      slides.length &&
      window.innerWidth > 800 &&
      !reducedMotion
    ) {


      const getStartX =
        () => {

          const first =
            slides[0];


          const firstCenter =
            first.offsetLeft +
            first.offsetWidth / 2;


          return (
            window.innerWidth / 2 -
            firstCenter
          );

        };


      const getEndX =
        () => {

          const last =
            slides[
              slides.length - 1
            ];


          const lastCenter =
            last.offsetLeft +
            last.offsetWidth / 2;


          return (
            window.innerWidth / 2 -
            lastCenter
          );

        };


      gsap.fromTo(
        track,

        {
          x: () =>
            getStartX(),
        },

        {

          x: () =>
            getEndX(),

          ease:
            "none",

          scrollTrigger: {

            trigger:
              section,

            start:
              "top top",

            end: () =>
              `+=${
                window.innerHeight *
                (
                  slides.length -
                  1
                ) *
                1.05
              }`,

            pin:
              sticky,

            scrub:
              0.7,

            anticipatePin:
              1,

            invalidateOnRefresh:
              true,

            snap: {

              snapTo:
                1 /
                (
                  slides.length -
                  1
                ),

              duration: {
                min: 0.2,
                max: 0.42,
              },

              delay:
                0.03,

              ease:
                "power2.inOut",

            },


            onUpdate:
              (self) => {

                const index =
                  Math.round(
                    self.progress *
                    (
                      slides.length -
                      1
                    )
                  );


                updateProjectInfo(
                  index
                );


                updateSlides();


                if (progressFill) {

                  progressFill.style.transform =
                    `scaleX(${self.progress})`;

                }

              },


            onRefresh:
              () => {

                updateSlides();

              },

          },

        }
      );


      updateProjectInfo(0);


      requestAnimationFrame(
        updateSlides
      );

    }


    /* REVEALS */

    if (!reducedMotion) {

      const revealItems =
        document.querySelectorAll(
          ".section-intro, .about-story, .aligned-table, .career-table, .education-block, .contact-list, .contact-closing"
        );


      revealItems.forEach(
        (element) => {

          gsap.from(
            element,
            {

              opacity: 0,

              y: 24,

              duration: 0.75,

              ease: "power3.out",

              scrollTrigger: {

                trigger:
                  element,

                start:
                  "top 90%",

              },

            }
          );

        }
      );

    }

  </script>

</Layout>


