---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
---

<Layout
  title="Benjamin Aamann — Portfolio"
  description="Portfolio by Benjamin Aamann — Visual Design, Content Creation & Digital Marketing."
>
  <main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

      <div class="hero__background"></div>
      <div class="hero__image"></div>
      <div class="hero__overlay"></div>

      <header class="hero__top">

        <a
          href="/"
          class="logo"
          aria-label="Benjamin Aamann - Home"
        >
          BA.
        </a>

        <nav
          class="nav"
          aria-label="Main navigation"
        >
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </nav>

        <span class="language">
          EN
        </span>

      </header>


      <div class="hero__content">

        <div class="hero__disciplines">
          <span>VISUAL DESIGN</span>
          <span>CONTENT CREATION</span>
          <span>DIGITAL MARKETING</span>
        </div>


        <div class="hero__main">

          <h1>
            BENJAMIN<br />
            AAMANN
          </h1>

          <p class="hero__intro">
            I create visual solutions that connect ideas with people.
            As a Multimedia Design student, I work across visual design,
            content creation and digital marketing.
          </p>

          <a
            href="#work"
            class="hero__link"
          >
            <span class="hero__arrow">
              ↗
            </span>

            <span>
              VIEW SELECTED WORK
            </span>
          </a>

        </div>


        <div class="hero__quote">
          <span>Good people</span>
          <span>create</span>
          <span>great things.</span>
        </div>

      </div>


      <div class="hero__footer">

        <span>
          COPENHAGEN, DENMARK
        </span>

        <span class="scroll">
          SCROLL TO EXPLORE
          <span class="scroll__line"></span>
        </span>

        <span class="hero__footer-right">
          CREATIVE THINKER<br />
          DOER
        </span>

      </div>

    </section>


    <!-- =====================================================
         01 — SELECTED WORK
    ====================================================== -->

    <section
      class="content-section work-intro"
      id="work"
    >

      <div class="section-bar">

        <span>
          01
        </span>

        <span>
          SELECTED WORK
        </span>

        <span>
          05 PROJECTS
        </span>

      </div>


      <div class="section-intro">

        <h2>
          SELECTED WORK
        </h2>


        <div class="section-intro__side">

          <p>
            A selection of projects across visual design,
            content creation and digital marketing — from
            academic work to independent ideas and my own startup.
          </p>

          <span class="section-note">
            SCROLL TO EXPLORE ↓
          </span>

        </div>

      </div>

    </section>


    <!-- =====================================================
         DESKTOP PROJECT SLIDER
    ====================================================== -->

    <section class="project-scroll">

      <div class="project-scroll__sticky">

        <div class="project-header">

          <span>
            SELECTED WORK
          </span>

          <span class="project-header__number">
            01 / 05
          </span>

        </div>


        <div class="project-info">

          <span class="project-info__number">
            01
          </span>

          <span class="project-info__type">
            OWN STARTUP
          </span>

          <h2 class="project-info__title">
            WeCoModels
          </h2>

          <p class="project-info__disciplines">
            Platform · Branding · UX/UI · Marketing
          </p>

          <span class="project-info__action">
            VISIT WEBSITE ↗
          </span>

        </div>


        <div class="project-rail">

          <div class="project-track">

            {
              projects.map((project, index) => {

                const content = (
                  <>
                    <img
                      src={project.cover}
                      alt={project.title}
                      loading={index < 2 ? "eager" : "lazy"}
                    />

                    <div class="project-slide__caption">

                      <span>
                        {project.title}
                      </span>

                      <span>
                        {
                          project.destination === "coming-soon"
                            ? "—"
                            : "↗"
                        }
                      </span>

                    </div>
                  </>
                );


                if (project.destination === "coming-soon") {

                  return (
                    <article
                      class="project-slide project-slide--disabled"
                      data-index={index}
                      data-number={project.number}
                      data-title={project.title}
                      data-type={project.type}
                      data-disciplines={project.disciplines.join(" · ")}
                      data-action="COMING SOON"
                    >
                      {content}
                    </article>
                  );

                }


                return (
                  <a
                    class="project-slide project-slide--clickable"
                    href={project.href}
                    target={
                      project.destination === "external"
                        ? "_blank"
                        : undefined
                    }
                    rel={
                      project.destination === "external"
                        ? "noopener noreferrer"
                        : undefined
                    }
                    data-index={index}
                    data-number={project.number}
                    data-title={project.title}
                    data-type={project.type}
                    data-disciplines={project.disciplines.join(" · ")}
                    data-action={project.buttonText}
                    aria-label={`${project.title} - ${project.buttonText}`}
                  >
                    {content}
                  </a>
                );

              })
            }

          </div>

        </div>


        <div
          class="project-focus-frame"
          aria-hidden="true"
        ></div>


        <div class="project-bottom">

          <span class="project-bottom__current">
            01
          </span>

          <div class="project-progress">
            <span class="project-progress__fill"></span>
          </div>

          <span>
            05
          </span>

        </div>

      </div>


      <!-- =====================================================
           MOBILE PROJECT LIST
      ====================================================== -->

      <div class="mobile-projects">

        <div class="mobile-projects__top">

          <span>
            SELECTED WORK
          </span>

          <span>
            05 PROJECTS
          </span>

        </div>


        {
          projects.map((project, index) => {

            const projectNumber =
              String(index + 1).padStart(2, "0");


            return (
              <article class="mobile-project">

                <div class="mobile-project__meta">

                  <span>
                    {projectNumber}
                  </span>

                  <span>
                    {project.type}
                  </span>

                </div>


                <h3>
                  {project.title}
                </h3>


                <p class="mobile-project__disciplines">
                  {project.disciplines.join(" · ")}
                </p>


                {
                  project.destination === "coming-soon" ? (

                    <span class="mobile-project__link mobile-project__link--disabled">
                      COMING SOON
                    </span>

                  ) : (

                    <a
                      href={project.href}
                      target={
                        project.destination === "external"
                          ? "_blank"
                          : undefined
                      }
                      rel={
                        project.destination === "external"
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="mobile-project__link"
                    >
                      {project.buttonText.toUpperCase()} ↗
                    </a>

                  )
                }


                {
                  project.destination === "coming-soon" ? (

                    <div class="mobile-project__image mobile-project__image--disabled">

                      <img
                        src={project.cover}
                        alt={project.title}
                        loading="lazy"
                      />

                      <span>
                        COMING SOON
                      </span>

                    </div>

                  ) : (

                    <a
                      href={project.href}
                      target={
                        project.destination === "external"
                          ? "_blank"
                          : undefined
                      }
                      rel={
                        project.destination === "external"
                          ? "noopener noreferrer"
                          : undefined
                      }
                      class="mobile-project__image"
                      aria-label={`${project.title} - ${project.buttonText}`}
                    >

                      <img
                        src={project.cover}
                        alt={project.title}
                        loading="lazy"
                      />

                    </a>

                  )
                }

              </article>
            );

          })
        }

      </div>

    </section>


    <!-- =====================================================
         02 — ABOUT
    ====================================================== -->

